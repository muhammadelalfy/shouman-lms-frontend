# Server-only (never prefixed with NEXT_PUBLIC_): the browser never talks to Laravel directly.
API_BASE_URL=http://localhost:8000/api/v1
API_TIMEOUT_MS=10000

# Dedicated shared admin credentials: local demo only, disabled by default.
LOCAL_DEMO_MODE=false
ADMIN_TRIAL_LOGIN_ENABLED=false
ADMIN_TRIAL_LOGIN_EMAIL=
ADMIN_TRIAL_LOGIN_PASSWORD=
